@model CafeteriaAromas.Models.Product

@{
    ViewData["Title"] = "Actualizar Producto";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            
            <!-- Botón para regresar -->
            <a asp-controller="Product" asp-action="ListProducts" class="btn btn-link text-decoration-none p-0 mb-3">
                Volver a la lista
            </a>

            <div class="card shadow-sm card-static">
                <!-- Encabezado -->
                <div class="card-header bg-white py-3 px-4">
                    <h1 class="h5 mb-0 fw-bold text-primary">
                        Registrar Nuevo Producto
                    </h1>
                </div>

                <!-- Formulario -->
                <div class="card-body p-4">
                    <form asp-controller="Product" asp-action="UpdateProduct" method="post">
                        <input asp-for="Id" type="hidden"/>
                        
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Nombre del Producto -->
                        <fieldset class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Nombre del Producto</label>
                            <input asp-for="Name" class="form-control" placeholder="Ej. Capuchino Tradicional 300ml" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </fieldset>
                        
                        @* TODO: falta poner el comboBox pa elegir la categoria *@

                        <!-- Precios y Costos (en paralelo) -->
                        <div class="row g-3 mb-3">
                            <fieldset class="col-6">
                                <label asp-for="SellingPrice" class="form-label fw-bold">Precio Venta (Bs.)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">Bs.</span>
                                    <input asp-for="SellingPrice" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                            </fieldset>

                            <fieldset class="col-6">
                                <label asp-for="ProductionCost" class="form-label fw-bold">Costo Est. (Bs.)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">Bs.</span>
                                    <input asp-for="ProductionCost" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="ProductionCost" class="text-danger small"></span>
                            </fieldset>
                        </div>

                        <!-- Acciones -->
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                Guardar Cambios
                            </button>
                            <a asp-controller="Product" asp-action="ListProducts" class="btn btn-outline-secondary">
                                Volver
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>