@using CafeteriaAromas.ViewModels
@model ProductViewModel

@{
    ViewData["Title"] = "Actualizar Producto";
}

<div class="container pt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            
            <!-- Botón para regresar -->
            <a asp-controller="Products" asp-action="Index" class="btn btn-link p-0 mb-3 d-inline-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> Volver a la lista
            </a>

            <div class="card card-static shadow-sm">
                <!-- Encabezado -->
                <div class="card-header bg-transparent py-3 px-4 border-bottom">
                    <h1 class="h5 mb-0 fw-bold text-primary d-flex align-items-center gap-2">
                        <i class="bi bi-cup-hot-fill"></i> Actualizar Producto
                    </h1>
                </div>

                <!-- Formulario -->
                <div class="card-body p-4">
                    <form asp-controller="Products" asp-action="UpdateProduct" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <!-- Resumen de validaciones generales -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                        <!-- Nombre del Producto -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Nombre del Producto</label>
                            <input asp-for="Name" class="form-control" placeholder="Ej. Capuchino Tradicional 300ml" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        
                        <!-- Categoría -->
                        <div class="mb-3">
                            <label asp-for="ProductCategoryId" class="form-label fw-bold">Categoría</label>
                            <select asp-for="ProductCategoryId" asp-items="Model.Categories" class="form-select">
                                <option value="" selected disabled>-- Selecciona una categoría --</option>
                            </select>
                            <span asp-validation-for="ProductCategoryId" class="text-danger small"></span>
                        </div>

                        <!-- Precios y Costos (en paralelo) -->
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label asp-for="SellingPrice" class="form-label fw-bold">Precio Venta</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted fw-bold">Bs.</span>
                                    <input asp-for="SellingPrice" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                            </div>

                            <div class="col-6">
                                <label asp-for="ProductionCost" class="form-label fw-bold">Costo Est.</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted fw-bold">Bs.</span>
                                    <input asp-for="ProductionCost" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="ProductionCost" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Acciones -->
                        <div class="d-grid gap-2 mt-4 pt-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle-fill me-1"></i> Guardar Producto
                            </button>
                            <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">
                                Cancelar
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}