@model List<CafeteriaAromas.ViewModels.ProductListViewModel>

@{
    ViewData["Title"] = "Productos";
}

<div class="container py-4">
    <div class="row justify-content-center my-4">
        <div class="col-12 col-xl-10">
            <div class="card shadow-sm card-static">
                
                <!-- Encabezado de la Tarjeta -->
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h1 class="h4 mb-0 fw-bold text-primary">
                        Lista de Productos
                    </h1>
                    <a class="btn btn-primary d-inline-flex align-items-center gap-2" 
                       asp-controller="Products" asp-action="NewProduct">
                        Nuevo Producto
                    </a>
                </div>

                <!-- Cuerpo de la Tarjeta / Tabla -->
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center px-3">ID</th>
                                    <th>Nombre</th>
                                    <th class="text-end">Precio (Bs.)</th>
                                    <th class="text-end">Costo E. (Bs.)</th>
                                    <th class="text-center">Categoría</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var proc in Model)
                                    {
                                        <tr>
                                            <td class="text-center text-muted fw-bold px-3">#@proc.Id</td>
                                            <td class="fw-semibold">@proc.Name</td>
                                            <td class="text-end text-nowrap">@proc.SellingPrice.ToString("N2")</td>
                                            <td class="text-end text-nowrap text-muted">@proc.ProductionCost.ToString("N2")</td>
                                            <td class="text-center">
                                                <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                    @proc.CategoryName
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm" role="group" aria-label="Acciones de producto">
                                                    <a asp-controller="Products" asp-action="UpdateProduct" 
                                                       asp-route-id="@proc.Id" 
                                                       class="btn btn-outline-primary" 
                                                       title="Editar producto">
                                                        Editar
                                                    </a>
                                                    <a asp-controller="Products" 
                                                       asp-action="DeleteProduct" 
                                                       asp-route-id="@proc.Id" 
                                                       onclick="return confirmDelete('@proc.Name')" 
                                                       class="btn btn-outline-danger" 
                                                       title="Eliminar producto">
                                                        Eliminar
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                            No se encontraron productos registrados.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(productName) {
            return confirm(`¿Estás seguro de que deseas eliminar el producto "${productName}"?`);
        }
    </script>
}