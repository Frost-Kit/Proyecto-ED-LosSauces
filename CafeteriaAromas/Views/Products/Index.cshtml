@model List<CafeteriaAromas.ViewModels.ProductListViewModel>

@{
    ViewData["Title"] = "Productos";
}

<div class="container py-4">
    <div class="row justify-content-center my-2">
        <div class="col-12 col-xl-10">
            <div class="card shadow-sm card-static border-0">
                
                <!-- Encabezado de la Tarjeta -->
                <div class="card-header bg-transparent py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                    <div>
                        <h2 class="h4 mb-0 fw-bold text-brown">
                            <i class="bi bi-grid" style="margin-right: 10px"></i>Lista de Productos
                        </h2>
                        <small class="text-muted">Administra el catálogo y precios de la cafetería</small>
                    </div>
                    <a class="btn btn-primary d-inline-flex align-items-center gap-2" 
                       asp-controller="Products" asp-action="NewProduct">
                        <i class="bi bi-plus-lg"></i> Nuevo Producto
                    </a>
                </div>

                <!-- Cuerpo de la Tarjeta / Tabla -->
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center px-3" style="width: 70px;">ID</th>
                                    <th>Nombre</th>
                                    <th class="text-end">Precio (Bs.)</th>
                                    <th class="text-end">Costo E. (Bs.)</th>
                                    <th class="text-center">Categoría</th>
                                    <th class="text-center" style="width: 160px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var proc in Model)
                                    {
                                        <tr>
                                            <td class="text-center text-muted fw-bold px-3">#@proc.Id</td>
                                            <td class="fw-semibold text-dark">@proc.Name</td>
                                            <td class="text-end text-nowrap fw-bold text-success">
                                                @proc.SellingPrice.ToString("N2")
                                            </td>
                                            <td class="text-end text-nowrap text-muted">
                                                @proc.ProductionCost.ToString("N2")
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                                    @proc.CategoryName
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm" role="group" aria-label="Acciones de producto">
                                                    <!-- Receta -->
                                                    <a asp-controller="Recipes" asp-action="Index" asp-route-productId="@proc.Id" 
                                                       class="btn btn-outline-brown" 
                                                       title="Gestionar Receta">
                                                        <i class="bi bi-journal-text"></i>
                                                    </a>

                                                    <!-- Editar -->
                                                    <a asp-controller="Products" asp-action="UpdateProduct" 
                                                       asp-route-id="@proc.Id" 
                                                       class="btn btn-outline-primary" 
                                                       title="Editar producto">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>

                                                    <!-- Eliminar (Mantiene el flujo JS original) -->
                                                    <a asp-controller="Products" 
                                                       asp-action="DeleteProduct" 
                                                       asp-route-id="@proc.Id" 
                                                       onclick="return confirmDelete('@proc.Name')" 
                                                       class="btn btn-outline-danger" 
                                                       title="Eliminar producto">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted">
                                            <i class="bi bi-inbox fs-1 d-block mb-2 text-brown opacity-50"></i>
                                            No se encontraron productos registrados.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(productName) {
            return confirm(`¿Estás seguro de que deseas eliminar el producto "${productName}"?`);
        }
    </script>
}