@model CafeteriaAromas.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Cafeteria Aromas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-main m-0">

    <main class="d-flex align-items-center justify-content-center min-vh-100">
        <div class="container">
            <div class="row justify-content-center">
                <section class="col-8 col-md-7 col-lg-6">
                    <article class="card shadow-lg border-0">
                        <header class="card-header pt-4 bg-transparent border-0 text-center">
                            <h1 class="card-title h3 fw-semibold m-0">@ViewData["Title"]</h1>
                        </header>
                        <div class="card-body p-4">
                            <form asp-action="Login" method="post">
                                <fieldset class="mb-3 border-0 p-0 m-0">
                                    <label asp-for="Email" class="form-label fw-medium"></label>
                                    <input asp-for="Email" class="form-control" placeholder="nombre@ejemplo.com" type="email" required/>
                                </fieldset>

                                <fieldset class="mb-3 border-0 p-0 m-0">
                                    <label asp-for="Password" class="form-label fw-medium">Contraseña</label>
                                    <input asp-for="Password" class="form-control" type="password" required/>
                                </fieldset>

                                @if (ViewData["Message"] != null)
                                {
                                    <div class="alert alert-danger" role="alert">
                                        @ViewData["Message"]
                                    </div>
                                }

                                <button type="submit" class="btn btn-secondary w-100 fs-6 mt-2">Ingresar</button>

                                <p class="text-center text-muted mt-3 mb-0 small">
                                    Si no tiene una cuenta póngase en contacto con la Administración
                                </p>
                            </form>
                        </div>
                    </article>
                </section>
            </div>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>