@model CafeteriaAromas.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Cafeteria Aromas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
</head>
<body>
    <header></header>
    <main class="row justify-content-center my-5">
        <section class="col-sm-8 col-md-7 col-lg-4">
            <article class="card shadow-lg border-0">
                <div class="card-header pt-3">
                    <h3 class="card-title text-center fw-semibold">@ViewData["Title"]</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Login" method="post">
                        <fieldset class="mb-3">
                            <label asp-for="Email" class="form-label fw-medium"></label>
                            <input asp-for="Email" class="form-control" placeholder="nombre@ejemplo.com" type="email" required/>
                        </fieldset>

                        <fieldset class="mb-3">
                            <label asp-for="Password" class="form-label fw-medium">Contraseña</label>
                            <input asp-for="Password" class="form-control" type="password" required/>
                        </fieldset>

                        @if (ViewData["Message"] != null)
                        {
                            <div class="alert alert-danger" role="alert">
                                @ViewData["Message"]
                            </div>
                        }

                        <button type="submit" class="btn btn-primary w-100 fs-6">Ingresar</button>

                        @* info extra *@
                        <div class="form text-center text-muted mt-3">
                            Si no tiene una cuenta pongase en contacto con la Administracion
                        </div>
                    </form>
                </div>
            </article>
        </section>
    </main>

    <footer></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

