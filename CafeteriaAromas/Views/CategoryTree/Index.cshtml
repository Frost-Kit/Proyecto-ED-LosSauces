@using CafeteriaAromas.DataStructures.Clases
@model NodoGeneral<string>
@{
    ViewData["Title"] = "Árbol de Categorías";
}

<style>
    ul.tree-ui {
        list-style-type: none;
    }

    ul.tree-ui, ul.tree-ui ul {
        margin: 0;
        padding: 0;
    }

    ul.tree-ui ul {
        padding-left: 20px;
        border-left: 2px dashed var(--accent-caramel);
        margin-left: 10px;
        display: none;
    }

    ul.tree-ui li {
        margin: 5px 0;
        padding-left: 15px;
        position: relative;
    }

    ul.tree-ui li::before {
        content: '';
        position: absolute;
        top: 12px;
        left: 0;
        width: 12px;
        border-top: 2px dashed var(--accent-caramel);
    }

    .tree-caret {
        cursor: pointer;
        user-select: none;
        color: var(--text-primary);
        font-weight: 600;
        transition: color 0.2s;
    }

    .tree-caret::before {
        content: "\25B6";
        color: var(--accent-brown);
        display: inline-block;
        margin-right: 6px;
        transition: transform 0.2s;
    }

    .tree-caret:hover {
        color: var(--accent-caramel-hover);
    }

    .tree-caret-down::before {
        transform: rotate(90deg);
    }

    .tree-leaf {
        color: var(--text-muted);
        font-weight: 500;
    }

    .active-tree {
        display: block !important;
    }
</style>

<div class="container my-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom pt-4 pb-2">
            <h2 class="h4 text-dark"><i class="bi bi-diagram-3"></i> Menú por categorías</h2>
        </div>
        <div class="card-body p-4">

            @{
                void RenderTree(NodoGeneral<string> nodo)
                {
                    if (nodo.Hijos != null && nodo.Hijos.Count > 0)
                    {
                        <span class="tree-caret fs-5">@nodo.Valor</span>
                        <ul class="nested">
                            @foreach (var hijo in nodo.Hijos)
                            {
                                <li>
                                    @{ RenderTree(hijo); }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="tree-leaf"><i class="bi bi-dot"></i> @nodo.Valor</span>
                    }
                }
            }

            <ul class="tree-ui mt-2">
                <li>
                    @{ RenderTree(Model); }
                </li>
            </ul>

        </div>
    </div>
</div>

@section Scripts {
    <script>

        document.addEventListener("DOMContentLoaded", function () {
            var toggler = document.getElementsByClassName("tree-caret");
            for (var i = 0; i < toggler.length; i++) {
                toggler[i].addEventListener("click", function () {
                    this.classList.toggle("tree-caret-down");
                    var nestedList = this.nextElementSibling;
                    if (nestedList) {
                        nestedList.classList.toggle("active-tree");
                    }
                });
            }
        });
    </script>
}