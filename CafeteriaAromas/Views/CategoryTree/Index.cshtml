@using CafeteriaAromas.DataStructures.Clases
@model NodoGeneral<string>
@{
    ViewData["Title"] = "Menú por categorías";
}

<div class="container my-5">
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden card-static">
        <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 d-flex align-items-center">
            <div class="text-white rounded-circle d-flex align-items-center justify-content-center me-3"
                 style="width: 48px; height: 48px; background-color: var(--accent-brown);">
                <i class="bi bi-diagram-3 fs-4"></i>
            </div>
            <h2 class="h4 text-dark mb-0 fw-bold">@ViewData["Title"]</h2>
        </div>

        <div class="card-body p-4 p-md-5 bg-transparent">
            @{
                // Agregamos "nivel" para saber en qué parte del árbol estamos
                void RenderTree(NodoGeneral<string> nodo, int nivel = 0)
                {
                    // 1. Asignamos clases dinámicas según la profundidad y el contenido
                    string iconClass = nivel switch
                    {
                        0 => "bi-shop text-dark", // Raíz
                        1 => "bi-tags-fill text-caramel", // Categorías
                        2 => "bi-cup-hot-fill text-brown", // Productos
                        _ => nodo.Valor.StartsWith("Instrucciones:") // Nivel final
                            ? "bi-card-text text-info" // Ícono de texto para la receta
                            : "bi-box-seam text-sage" // Ícono de caja para el ingrediente
                    };

                    string textClass = nivel switch
                    {
                        0 => "fs-4 fw-bold text-dark",
                        1 => "fs-5 fw-semibold text-dark",
                        2 => "fs-6 fw-bold text-secondary",
                        _ => "fs-6 text-muted"
                    };
                    //Verificación de los hijos
                    if (nodo.Hijos != null && nodo.Hijos.Count > 0)
                    {
                        <div class="tree-node-wrapper my-1">
                            <span class="tree-caret @textClass">
                                <i class="bi @iconClass me-2"></i>@nodo.Valor
                            </span>
                            <ul class="nested-tree">
                                @foreach (var hijo in nodo.Hijos)
                                {
                                    <li>
                                        @{ RenderTree(hijo, nivel + 1); }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="tree-leaf-wrapper my-1">
                            <span class="tree-leaf @textClass">
                                <i class="bi @iconClass me-2"></i>@nodo.Valor
                            </span>
                        </div>
                    }
                }
            }

            <ul class="tree-ui">
                <li>
                    @{ RenderTree(Model, 0); }
                </li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let toggler = document.getElementsByClassName("tree-caret");
            for (let i = 0; i < toggler.length; i++) {
                toggler[i].addEventListener("click", function () {
                    this.classList.toggle("tree-caret-down");
                    let nestedList = this.nextElementSibling;
                    if (nestedList) {
                        nestedList.classList.toggle("active-tree");
                    }
                });
            }
        });
    </script>
}