@model CafeteriaAromas.ViewModels.RecipeManagementViewModel

@{
    ViewData["Title"] = "Gestión de Recetas";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-brown"><i class="bi bi-journal-richtext me-2"></i>Gestión de Recetas</h2>
            <p class="text-muted mb-0">Selecciona un producto para gestionar sus ingredientes e instrucciones.</p>
        </div>
    </div>

    <!-- 1. BÚSQUEDA / SELECCIÓN DE PRODUCTO -->
    <div class="card mb-4 card-static">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-9">
                    <label for="productId" class="form-label fw-bold text-brown">Seleccionar Producto</label>
                    <select id="productId" name="productId" class="form-select" asp-items="Model.ProductList">
                        <option value="" disabled selected>-- Elige un producto --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i> Cargar Receta
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.SelectedProductId.HasValue)
    {
        <!-- FORMULARIO PRINCIPAL DE LA RECETA -->
        <form asp-action="SaveRecipe" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="RecipeId" />
            <input type="hidden" asp-for="SelectedProductId" />

            <div class="row g-4">
                <!-- INSTRUCCIONES -->
                <div class="col-lg-5">
                    <div class="card h-100 card-static">
                        <div class="card-header bg-transparent border-0 pt-3 px-3">
                            <h5 class="card-title mb-0 text-brown">
                                <i class="bi bi-list-task me-2"></i>Indicaciones / Preparación
                            </h5>
                        </div>
                        <div class="card-body">
                            <label asp-for="Instructions" class="form-label text-muted fw-semibold mb-2">
                                Pasos de elaboración
                            </label>
                            <textarea class="form-control textarea-fixed" 
                                    asp-for="Instructions" 
                                    placeholder="Instrucciones de preparación..." 
                                    rows="8"></textarea>
                            <span asp-validation-for="Instructions" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- TABLA DE INGREDIENTES -->
                <div class="col-lg-7">
                    <div class="card h-100 card-static">
                        <div class="card-header bg-transparent border-0 pt-3 px-3">
                            <h5 class="card-title mb-0 text-brown"><i class="bi bi-basket me-2"></i>Ingredientes</h5>
                        </div>
                        <div class="card-body p-0">
                            <!-- FORMULARIO SECUNDARIO PARA AÑADIR INSUMO DESDE C# -->
                            <div class="p-3 bg-light border-bottom">
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-6">
                                        <label class="form-label small text-muted">Insumo</label>
                                        <select name="newSupplyId" class="form-select form-select-sm" asp-items="Model.AvailableSupplies">
                                            <option value="" disabled selected>-- Seleccionar Insumo --</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted">Cantidad</label>
                                        <input type="number" step="0.001" min="0.001" name="newQuantity" class="form-control form-control-sm" placeholder="Ej: 0.500" />
                                    </div>
                                    <div class="col-md-3 pb-1">
                                        <button type="submit" asp-action="AddIngredient" class="btn btn-sm btn-outline-brown w-100">
                                            <i class="bi bi-plus-lg me-1"></i> Añadir
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="px-3">Insumo</th>
                                            <th style="width: 150px;">Cantidad</th>
                                            <th style="width: 100px;">Unidad</th>
                                            <th style="width: 60px;" class="text-center px-3">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Ingredients != null && Model.Ingredients.Any())
                                        {
                                            for (int i = 0; i < Model.Ingredients.Count; i++)
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="hidden" name="Ingredients[@i].SupplyId" value="@Model.Ingredients[i].SupplyId" />
                                                        <input type="hidden" name="Ingredients[@i].RecipeSupplyId" value="@Model.Ingredients[i].RecipeSupplyId" />
                                                        <input type="hidden" name="Ingredients[@i].SupplyName" value="@Model.Ingredients[i].SupplyName" />
                                                        <input type="hidden" name="Ingredients[@i].UnitOfMeasure" value="@Model.Ingredients[i].UnitOfMeasure" />
                                                        <span class="fw-semibold px-2">@Model.Ingredients[i].SupplyName</span>
                                                    </td>
                                                    <td>
                                                        <input type="number" 
                                                               step="0.001" 
                                                               min="0.001" 
                                                               name="Ingredients[@i].IngredientQuantity" 
                                                               class="form-control form-control-sm text-end" 
                                                               value="@Model.Ingredients[i].IngredientQuantity" />
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-secondary">@Model.Ingredients[i].UnitOfMeasure</span>
                                                    </td>
                                                    <td class="text-center px-3">
                                                        <button type="submit" 
                                                                asp-action="RemoveIngredient" 
                                                                asp-route-index="@i" 
                                                                class="btn btn-sm btn-outline-danger border-0">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center text-muted py-4">
                                                    No hay ingredientes agregados.
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- BOTÓN GUARDAR -->
            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-check-circle me-2"></i>Guardar Receta Completa
                </button>
            </div>
        </form>
    }
</div>